{
  // No JDK path is hardcoded here. This file is committed and shared, and an
  // absolute path is by definition specific to one machine and one OS —
  // /opt/homebrew/... is meaningless on Linux or Windows.
  //
  // The Java extension resolves its JDK from JDK_HOME, then JAVA_HOME, then
  // PATH. Setting JAVA_HOME correctly (docs/00-local-setup.md §0.2) therefore
  // configures the editor and the Maven wrapper at once, on every platform.
  //
  // Caveat: an editor launched from a desktop icon does not inherit shell
  // environment. Either launch it with `code .` from a configured terminal, or
  // set `java.configuration.runtimes` in your *user* settings — which is where a
  // machine-specific path belongs.
  "java.compile.nullAnalysis.mode": "automatic",
  "java.configuration.updateBuildConfiguration": "automatic",

  // Spotless is the authority on Java style (./mvnw spotless:apply), so the
  // editor must not reformat on save and start a fight with it.
  "[java]": { "editor.formatOnSave": false },

  "files.exclude": {
    "**/target": true,
    "**/node_modules": true
  },
  "search.exclude": {
    "**/target": true,
    "**/node_modules": true,
    "**/pnpm-lock.yaml": true
  },

  "js/ts.tsdk.path": "frontend/node_modules/typescript/lib",
  "editor.codeActionsOnSave": { "source.fixAll.oxc": "explicit" },
  "[typescript]": { "editor.formatOnSave": true },
  "[typescriptreact]": { "editor.formatOnSave": true },

  "files.eol": "\n"
}
