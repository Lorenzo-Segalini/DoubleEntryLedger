POSTGRES_USER=ledger
POSTGRES_PASSWORD=ledger
POSTGRES_PORT=5432

BACKEND_PORT=8080
FRONTEND_PORT=5173

DEMO_OPERATOR_PASSWORD=demo-operator
DEMO_AUDITOR_PASSWORD=demo-auditor
DEMO_ADMIN_PASSWORD=demo-admin
